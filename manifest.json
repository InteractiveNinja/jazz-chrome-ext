{
    "name": "Calculate Worktime",
    "version": "2.0.0",
    "description": "Determines how long you should work if you want",
    "manifest_version": 3,
    "permissions": ["activeTab"],
    "content_scripts": [{
        "matches": ["https://jazz.hs.coop.ch/mobile/*", "https://jazz.coop.ch/mobile/*", "https://jazz.hs.coop.ch/client/mobile/*"],
        "js": ["/dist/main.js"]
    }],
    "browser_specific_settings": {
        "firefox": {
            "id": "calculate-worktime@jazz-ext",
            "strict_min_version": "109.0"
        }
    }
}